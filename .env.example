# Copy to .env.local and edit as needed. Every value has a working default.
#
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# GOLPO_DATA_DIR=./.data
# GOLPO_SESSION_SECRET=change-me-to-a-long-random-string
# GOLPO_DEV_API_KEY=glp_local_dev_key_change_me
# GOLPO_SIMULATED_RENDER_MS=14000
# GOLPO_MAX_CONCURRENT_JOBS=5
# PORT=3000

# ---------------------------------------------------------------------------
# Integration modes (auto | local | mock | groq | ffmpeg | supabase | stripe)
#
# `auto` (the default) enables a real provider as soon as its credentials or
# binaries are present, and otherwise keeps the local fallback.
# ---------------------------------------------------------------------------
# GOLPO_SCRIPT_MODE=auto        # auto -> groq when GROQ_API_KEY exists
# GOLPO_TTS_MODE=auto           # auto -> groq when GROQ_API_KEY exists
#   Narration engines: groq (Orpheus, English), edge (free Microsoft Edge
#   read-aloud voices, 50+ languages, no key, used automatically for
#   non-English scripts and as the fallback when Orpheus is rate limited),
#   none (silent video). Groq Orpheus is capped at 3,600 tokens/day on the
#   free tier, so Edge keeps narration working once that quota is spent.
# GOLPO_TRANSCRIBE_MODE=auto    # auto -> groq when GROQ_API_KEY exists
# GOLPO_RENDER_MODE=auto        # auto -> ffmpeg when ffmpeg-static is installed
# GOLPO_AUTH_MODE=auto          # auto -> supabase when SUPABASE_URL + ANON_KEY exist
# GOLPO_BILLING_MODE=auto       # auto -> stripe when STRIPE_SECRET_KEY exists

# ---------------------------------------------------------------------------
# Groq — real scripts, transcription and narration. Never commit keys.
# OpenAI is no longer used anywhere; Groq is OpenAI-compatible, so only the
# base URL and model names differ.
# ---------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# No OPENAI_API_KEY needed anymore
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GOLPO_GROQ_MODEL=openai/gpt-oss-120b
# GOLPO_GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# GOLPO_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus needs a one-time terms acceptance in the Groq console:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# GOLPO_GROQ_TTS_VOICE=hannah
# GOLPO_GROQ_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Scene artwork - free image generation. Optional; without it the renderer
# uses the bundled vector doodles.
#
# Cloudflare Workers AI (recommended): 10,000 free neurons/day, roughly 100
# FLUX.1-schnell images, no credit card. Create a token with the
# "Workers AI" permission at https://dash.cloudflare.com/profile/api-tokens
# and copy the account id from the dashboard URL.
#   GOLPO_IMAGE_MODE=cloudflare
#
# Pollinations (zero setup): no account, but one image per 45 seconds per IP,
# a small logo, and 402 responses once the slot is exhausted. Used by default
# when Cloudflare credentials are absent.
#   GOLPO_IMAGE_MODE=pollinations
#
# Off: local vector doodles only (fastest, fully offline).
#   GOLPO_IMAGE_MODE=off
# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_AI_TOKEN=...
# GOLPO_CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# GOLPO_IMAGE_MODE=auto         # auto -> cloudflare when configured, else pollinations
# GOLPO_POLLINATIONS_URL=https://image.pollinations.ai
# GOLPO_POLLINATIONS_INTERVAL_MS=46000
# GOLPO_IMAGE_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# Supabase — real auth. Email magic links work out of the box; Google/Microsoft
# OAuth is optional. Add this URL to the redirect allow-list:
#   http://localhost:3000/auth/callback*
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# ---------------------------------------------------------------------------
# Stripe — real subscriptions and credit packs (test mode recommended).
# Webhook forwarding: stripe listen --forward-to localhost:3000/api/stripe/webhook
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# GOLPO_STRIPE_CURRENCY=usd
# GOLPO_APP_URL=http://localhost:3000
# Keep unlimited credits even while Stripe is configured (useful for testing):
# GOLPO_UNLIMITED_DEV=1
